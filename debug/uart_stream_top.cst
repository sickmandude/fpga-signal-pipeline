// uart_stream_top.cst - continuous UART stream test on the Tang Nano 9K
IO_LOC "sys_clk" 52;
IO_LOC "sys_rst_n" 4;

// Pin 18 was shown (pin-probe test) to be driven by the USB bridge, so it is
// the FPGA's RX. Pin 17 is therefore the FPGA's TX.
IO_LOC "uart_tx_pin" 17;

IO_LOC "led_alive" 16;

IO_PORT "sys_clk" IO_TYPE=LVCMOS33;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS33;
IO_PORT "led_alive" IO_TYPE=LVCMOS33;
