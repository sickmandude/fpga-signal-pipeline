// adc_fir_uart_top.cst
// Pin constraints for adc_fir_uart_top.v on the Sipeed Tang Nano 9K (GW1NR-9C)

IO_LOC "sys_clk" 52;
IO_LOC "sys_rst_n" 4;

// MCP3008 (left header, Bank 2, 3.3V)
IO_LOC "adc_sclk" 25;
IO_LOC "adc_cs_n" 26;
IO_LOC "adc_mosi" 27;
IO_LOC "adc_miso" 28;

// USB-serial bridge. Pin 17 is the FPGA's TX in two working community
// examples (Lushay Labs, charkster/usb_pd_monitor). If nothing arrives on the
// Mac, try pin 18 here instead.
IO_LOC "uart_tx" 17;

// health LEDs (same pins as the debug build)
IO_LOC "led_valid" 16;
IO_LOC "led_sign" 15;

IO_PORT "sys_clk" IO_TYPE=LVCMOS33;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33;
IO_PORT "adc_mosi" IO_TYPE=LVCMOS33;
IO_PORT "adc_miso" IO_TYPE=LVCMOS33;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_PORT "led_valid" IO_TYPE=LVCMOS33;
IO_PORT "led_sign" IO_TYPE=LVCMOS33;
